{
  "metadata": {
    "title": "Focus App Aesthetic Transformation Instructions",
    "source_inspiration": "araam breathing app",
    "target_app": "focus tracker app",
    "objective": "Transform focus app to match araam's calm, meditative aesthetic while retaining all functionality",
    "created": "2025-10-08",
    "ai_readable": true,
    "validation_checklist_included": true
  },
  
  "design_philosophy": {
    "current_state": {
      "aesthetic": "Brutalist, high-contrast, aggressive productivity",
      "mood": "Intense, technical, utilitarian",
