  "troubleshooting": {
    "common_issues": [
      {
        "issue": "Colors not updating",
        "solution": "Ensure CSS custom properties are defined in :root and referenced with var()"
      },
      {
        "issue": "Fonts not loading",
        "solution": "Check Google Fonts link is in <head> before stylesheet, verify network tab shows fonts loading"
      },
      {
        "issue": "Dark mode not working",
        "solution": "Verify [data-theme='dark'] selector exists and setTheme() function updates document.documentElement attribute"
      },
      {
        "issue": "Transitions too slow/fast",
        "solution": "Adjust --transition-* variables in :root"
      },
      {
        "issue": "Functionality broken",
        "solution": "Check console for errors, verify JavaScript wasn't modified beyond theme toggle addition"
      },
      {
        "issue": "Layout broken on mobile",
        "solution": "Check media queries are preserved, verify responsive breakpoints"
      }
    ]
  },
  
