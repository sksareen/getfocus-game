  "tooltip_system": {
    "instruction": "Add araam-style tooltips to controls",
    "implementation": {
      "step_1": {
        "action": "Add tooltip CSS",
        "code": ".control-btn::after { content: attr(data-tooltip); position: absolute; bottom: calc(var(--base-unit) * -2.5); left: 50%; transform: translateX(-50%); background: var(--tooltip-bg); color: var(--text-color); padding: calc(var(--base-unit) * 0.4) calc(var(--base-unit) * 0.8); border-radius: var(--radius-sm); font-size: calc(var(--base-unit) * 0.8); white-space: nowrap; opacity: 0; visibility: hidden; transition: all var(--transition-fast); box-shadow: 0 2px 4px var(--tooltip-shadow); }"
      },
      "step_2": {
        "action": "Add hover effect",
        "code": ".control-btn:hover::after { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(-2px); }"
      },
      "step_3": {
        "action": "Add data-tooltip attributes in HTML",
        "examples": [
          {"element": "musicToggle", "tooltip": "Toggle audio (M)"},
          {"element": "webcamToggle", "tooltip": "Toggle webcam (W)"},
          {"element": "resetBtn", "tooltip": "Reset session (R)"}
        ]
      }
    },
    "validation": {
      "test_1": "Tooltips should appear on hover",
      "test_2": "Tooltips should have subtle animation",
      "test_3": "Tooltips should be readable in both themes"
    }
